# Default: auto-detect text, normalize to LF in repo
* text=auto eol=lf

# ---- Source code (LF, multi-platform) ----
*.c        text eol=lf
*.h        text eol=lf
*.cpp      text eol=lf
*.hpp      text eol=lf
*.cc       text eol=lf
*.cxx      text eol=lf
*.inc      text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
Makefile   text eol=lf
*.mk       text eol=lf

# ---- Windows-specific tooling (CRLF) ----
*.rc              text eol=crlf
*.rc2             text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user    text eol=crlf
*.vcproj          text eol=crlf
*.dsp             text eol=crlf
