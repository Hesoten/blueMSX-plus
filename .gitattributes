*.sln             text eol=crlf
*.props           text eol=crlf
*.targets         text eol=crlf
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf
*.def             text eol=crlf
*.manifest        text eol=crlf

