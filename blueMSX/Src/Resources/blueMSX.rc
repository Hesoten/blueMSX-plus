/////////////////////////////////////////////////////////////////////////////
//
// Version
//
// FileDescription / ProductName drive what Task Manager and Explorer show
// in place of the raw exe filename.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BLUE_MSX_VERSION_MAJOR,BLUE_MSX_VERSION_MINOR,0,BUILD_NUMBER
 PRODUCTVERSION BLUE_MSX_VERSION_MAJOR,BLUE_MSX_VERSION_MINOR,0,BUILD_NUMBER
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "blueMSX+ contributors"
            VALUE "FileDescription",  "blueMSX+"
            VALUE "FileVersion",      BLUE_MSX_VERSION
            VALUE "InternalName",     "blueMSX+"
            VALUE "LegalCopyright",   "Original blueMSX (C) 2003-2016 Daniel Vik and contributors. blueMSX+ fork (C) 2020-2026 blueMSX+ contributors."
            VALUE "OriginalFilename", "blueMSX+.exe"
            VALUE "ProductName",      "blueMSX+"
            VALUE "ProductVersion",   BLUE_MSX_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
