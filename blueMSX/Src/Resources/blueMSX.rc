IDD_BUTTON DIALOGEX 0, 0, 0, 0
STYLE DS_SETFONT | WS_CHILD
FONT 10, DEFAULT_FONT, 400, 0, 0x1
BEGIN
    PUSHBUTTON "TEXT",IDC_CONTROL,0,0,0,0
END

IDD_DROPDOWN DIALOGEX 0, 0, 0, 0
STYLE DS_SETFONT | WS_CHILD
FONT 10, DEFAULT_FONT, 400, 0, 0x1
BEGIN
    COMBOBOX        IDC_CONTROL,0,0,0,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_VIDEO_DIRECT3D DIALOGEX 0, 0, 320, 170
STYLE DS_SETFONT | WS_CHILD
FONT 10, DEFAULT_FONT, 400, 0, 0x1
BEGIN
    GROUPBOX        "Parameters ",IDC_D3D_PARAMETERSGROUPBOX,19,14,282,65

    CONTROL         "Linear filtering",IDC_D3D_LINEARFILTERING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,26,196,11
    CONTROL         "DeInterlace",IDC_MONDEINTERLACE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,41,100,11
    CONTROL         "Blend",IDC_MONBLENDFRAMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,56,125,11
END

IDD_VIDEO_SOFTWARE DIALOGEX 0, 0, 320, 221
STYLE DS_SETFONT | WS_CHILD
FONT 10, DEFAULT_FONT, 400, 0, 0x1
BEGIN
    GROUPBOX        "Monitor ",IDC_MONGROUPBOX,19,10,282,96
    ICON            IDI_MONITOR,IDC_STATIC,30,27,20,20
    LTEXT           "Monitor type:",IDC_MONTYPETEXT,65,23,95,11
    COMBOBOX        IDC_MONTYPE,161,20,120,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Monitor emulation:",IDC_MONEMUTEXT,65,37,95,11
    COMBOBOX        IDC_PALEMU,161,35,120,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Gamma:",IDC_MONGAMMATEXT,65,54,85,11
    CONTROL         "",IDC_MONGAMMASLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,52,97,13
    RTEXT           "100%",IDC_MONGAMMAVALUE,256,54,26,11
    LTEXT           "Brightness:",IDC_MONBRIGHTNESSTEXT,65,66,85,11
    CONTROL         "",IDC_MONBRIGHTNESSSLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,64,97,13
    RTEXT           "100%",IDC_MONBRIGHTNESSVALUE,256,66,26,11
    LTEXT           "Contrast:",IDC_MONCONTRASTTEXT,65,78,85,11
    CONTROL         "",IDC_MONCONTRASTSLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,76,97,13
    RTEXT           "100%",IDC_MONCONTRASTVALUE,256,78,26,11
    LTEXT           "Saturation:",IDC_MONSATURATIONTEXT,65,90,85,11
    CONTROL         "",IDC_MONSATURATIONSLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,88,97,13
    RTEXT           "100%",IDC_MONSATURATIONVALUE,256,90,26,11

    GROUPBOX        "Effects ",IDC_EFFECTSGB,19,110,282,104
    ICON            IDI_MONITOR,IDC_STATIC,30,124,20,20
    CONTROL         "DeInterlace",IDC_MONDEINTERLACE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,118,90,11
    CONTROL         "Linear filtering",IDC_D3D_LINEARFILTERING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,118,100,11
    CONTROL         "Blend",IDC_MONBLENDFRAMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,130,108,11

    CONTROL         " Scanlines:",IDC_SCANLINESENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,142,60,11
    LTEXT           "Preset:",IDC_SCANLINESHAPELABEL,135,144,35,11
    COMBOBOX        IDC_SCANLINESHAPEMODE,175,143,107,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Depth:",IDC_SCANLINESDEPTHLABEL,80,158,70,11
    CONTROL         "",IDC_SCANLINESSLIDEBAR,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,157,97,13
    RTEXT           "100%",IDC_SCANLINESVALUE,256,159,26,11

    LTEXT           "Sharpness:",IDC_SCANLINESHARPLABEL,80,170,70,11
    CONTROL         "",IDC_SCANLINESHAPESLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,169,97,13
    RTEXT           "p=2.0",IDC_SCANLINESHAPEVALUE,256,171,26,11

    LTEXT           "Bright comp:",IDC_SCANLINESBRIGHTLABEL,80,182,50,11
    CONTROL         " Auto",IDC_SCANLINESBRIGHTAUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,130,182,28,11
    CONTROL         "",IDC_SCANLINESBRIGHTSLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,181,97,13
    RTEXT           "1.00x",IDC_SCANLINESBRIGHTVALUE,256,183,26,11

    CONTROL         " ColorGhosting:",IDC_COLORGHOSTINGENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,197,87,11
    CONTROL         "",IDC_COLORGHOSTINGSLIDEBAR,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,196,97,13
    RTEXT           "0",IDC_COLORGHOSTINGVALUE,256,198,26,11
END

