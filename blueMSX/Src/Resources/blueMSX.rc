IDD_PERF_DIRECT3D DIALOGEX 0, 0, 300, 178
STYLE DS_SETFONT | WS_CHILD
FONT 10, DEFAULT_FONT, 400, 0, 0x1
BEGIN
    GROUPBOX        "Settings ",IDC_PERFSETTINGSGROUPBOX,7,6,282,88
    LTEXT           "Frame skipping:",IDC_PERFFRAMESKIPTEXT,55,17,105,11
    COMBOBOX        IDC_FRAMESKIP,161,15,110,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SYNC Mode:",IDC_PERFSYNCMODETEXT,55,31,105,11
    COMBOBOX        IDC_EMUSYNC,161,29,110,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Force high resolution",IDC_D3D_FORCEHIGHRES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,56,43,196,11
    CONTROL         "Extend border color",IDC_D3D_EXTENDBORDERCOLOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,56,55,196,11

    /* HDR controls live INSIDE the Settings group ("設定" in JP), not
    ** in a separate group, to keep the dialog compact.  Record-in-HDR
    ** and the system-HDR-mode indicator share a row to fit within the
    ** parent's tab-area height.  The white-brightness label is RTEXT
    ** so the Japanese caption (shorter) sits flush against the slider
    ** instead of leaving a gap. The HDR checkboxes share x=56 with
    ** Force/Extend above so the left edges line up cleanly. */
    CONTROL         " HDR",IDC_HDRENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,56,67,30,11
    RTEXT           "White brightness:",IDC_HDRPAPERWHITELABEL,87,68,68,11
    CONTROL         "",IDC_HDRPAPERWHITESLIDE,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,158,67,90,13
    RTEXT           "200",IDC_HDRPAPERWHITEVALUE,250,68,15,11
    CONTROL         "Record in HDR",IDC_HDRRECORD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,56,79,90,11
    RTEXT           "System HDR mode:",IDC_HDRMODESTATICTEXT,150,79,80,11
    LTEXT           "[--]",IDC_HDRMODELABEL,233,79,50,11

    GROUPBOX        "Crop ",IDC_D3D_CROPPINGGROUPBOX,7,98,282,71
    ICON            IDI_MONITOR,IDC_STATIC,20,110,20,20

    /* Crop rows: 2 columns, end-aligned with the combo above (right
    ** edge x=271).  Wide gap (16 du) between left value and Right /
    ** Bottom labels so the numbers don't bleed into the next field. */
    LTEXT           "Aspect Ratio:",IDC_D3D_ASPECTRATIOTEXT,55,109,90,11
    COMBOBOX        IDC_D3D_ASPECTRATIO,151,108,120,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Crop type:",IDC_D3D_CROPPING_TYPETEXT,55,125,90,11
    COMBOBOX        IDC_D3D_CROPPING_TYPE,151,123,120,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Left:",IDC_D3D_CROPPING_LEFTTEXT,55,140,22,11
    CONTROL         "",IDC_D3D_CROPPING_LEFT,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,80,138,46,13
    RTEXT           "0",IDC_D3D_CROPPING_LEFTVALUETEXT,128,140,14,11
    LTEXT           "Right:",IDC_D3D_CROPPING_RIGHTTEXT,182,140,30,11
    CONTROL         "",IDC_D3D_CROPPING_RIGHT,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,214,138,46,13
    RTEXT           "0",IDC_D3D_CROPPING_RIGHTVALUETEXT,261,140,10,11

    LTEXT           "Top:",IDC_D3D_CROPPING_TOPTEXT,55,154,22,11
    CONTROL         "",IDC_D3D_CROPPING_TOP,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,80,152,46,13
    RTEXT           "0",IDC_D3D_CROPPING_TOPVALUETEXT,128,154,14,11
    LTEXT           "Bottom:",IDC_D3D_CROPPING_BOTTOMTEXT,182,154,30,11
    CONTROL         "",IDC_D3D_CROPPING_BOTTOM,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,214,152,46,13
    RTEXT           "0",IDC_D3D_CROPPING_BOTTOMVALUETEXT,261,154,10,11
END


