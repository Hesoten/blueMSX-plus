// MS Shell Dlg is a locale-aware font alias: en -> MS Sans Serif,
// ja -> MS UI Gothic, ko -> Gulim. The latter two render the path
// separator byte 0x5C as a yen / won glyph respectively, which is
// what users on those locales expect for displayed paths. Using
// the alias here lets the OS pick the right font automatically
// instead of us substituting characters in code.
IDD_RECORDER_PICKFILES DIALOGEX 0, 0, 360, 98
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP |
    WS_CAPTION | WS_SYSMENU
CAPTION "blueMSX - Render Replay to Video"
FONT 11, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Source replay (.cap):",IDC_RECORDER_CAPLABEL,8,8,200,10
    EDITTEXT        IDC_RECORDER_CAPPATH,8,20,309,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_RECORDER_CAPBROWSE,322,20,30,14
    LTEXT           "Output video (.mp4):",IDC_RECORDER_MP4LABEL,8,42,200,10
    EDITTEXT        IDC_RECORDER_MP4PATH,8,54,309,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_RECORDER_MP4BROWSE,322,54,30,14
    DEFPUSHBUTTON   "OK",IDOK,260,78,42,14
    PUSHBUTTON      "Cancel",IDCANCEL,310,78,42,14
END

